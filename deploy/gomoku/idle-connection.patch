 private:
     MYSQL* _mysql;
     std::mutex _mutex;
+    std::string _host, _user, _password, _db;
+    uint16_t _port;
+
+    // Called under _mutex, before sending SQL. Never replay a failed write:
+    // a lost response does not prove the write was not committed.
+    bool execute_locked(const std::string& sql, bool* database_error = nullptr)
+    {
+        if (!_mysql || mysql_ping(_mysql) != 0) {
+            mysql_util::mysql_destory(_mysql);
+            _mysql = mysql_util::mysql_create(_host, _user, _password, _db, _port);
+            if (!_mysql) {
+                if (database_error) *database_error = true;
+                return false;
+            }
+            DLOG("Database connection re-established before query");
+        }
+        if (!mysql_util::mysql_exct(_mysql, sql)) {
+            // 1062 is an actual uniqueness conflict, not a connection failure.
+            if (database_error) *database_error = mysql_errno(_mysql) != 1062;
+            return false;
+        }
+        return true;
+    }
